generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id                String   @id @default(uuid())
  whatsappNumber    String   @unique
  telegramChatId    String?  @unique
  preferredMessagingChannel String? // "whatsapp" or "telegram"; detected from env if not set
  name              String
  language          String   @default("hi")
  cancerType        String
  treatmentProtocol String
  currentCycle      Int      @default(1)
  cycleStartDate    DateTime
  hospitalName      String
  doctorName        String
  doctorId          String?
  isActive          Boolean  @default(true)
  onboardingStep    Int      @default(0)
  onboardingData    Json?
  personalNotes     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Clinical identity fields
  dateOfBirth       DateTime?
  gender            String?       // M, F, OTHER
  stage             String?       // e.g., Stage IIIC, T2N1M0
  diagnosisDate     DateTime?
  primarySite       String?       // anatomical site of primary tumour
  histology         String?       // e.g., Infiltrating Ductal Carcinoma
  metastasisSites   String[]
  ecogScore         Int?          // 0–4 performance status
  bloodGroup        String?
  allergies         String[]
  comorbidities     String[]
  smokingStatus     String?

  assignedCoordinatorId String?
  assignedCoordinator   Coordinator?     @relation(fields: [assignedCoordinatorId], references: [id])

  checkins          Checkin[]
  medications       Medication[]
  appointments      Appointment[]
  alerts            Alert[]
  conversations     Conversation[]
  caregiver         Caregiver?
  doctor            Doctor?          @relation(fields: [doctorId], references: [id])
  labResults        LabResult[]
  imagingReports    ImagingReport[]
  pathologyReports  PathologyReport[]
  vitalSigns        VitalSign[]
  clinicalNotes     ClinicalNote[]
  documents         PatientDocument[]
  careTeamMembers   CareTeamMember[]
  extractedDrafts    ExtractedRecordDraft[]
  tumorBoardMeetings TumorBoardMeeting[]
  outboundMessages   OutboundMessage[]
  referrals          Referral[]
  careRecords        CareRecordGeneration[]
}

model Caregiver {
  id                String   @id @default(uuid())
  whatsappNumber    String   @unique
  name              String
  relationToPatient String
  patientId         String   @unique
  isEnrolled        Boolean  @default(false)
  createdAt         DateTime @default(now())

  patient       Patient                 @relation(fields: [patientId], references: [id])
  conversations CaregiverConversation[]
}

model Doctor {
  id                 String    @id @default(uuid())
  whatsappNumber     String    @unique
  name               String
  hospitalName       String
  specialization     String    @default("Oncology")
  practoId           String?
  apolloId           String?
  isOptedIn          Boolean   @default(false)
  // Extended profile fields
  registrationNumber String?   // MCI/NMC registration number
  qualifications     String[]  // ["MBBS", "MD (Medical Oncology)", "DM"]
  department         String?
  experienceYears    Int?
  secondaryPhone     String?
  email              String?
  availabilityNotes  String?   // free text: "Mon-Wed 10am-1pm OPD"
  photoUrl           String?
  bio                String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  patients        Patient[]
  careTeamMembers CareTeamMember[]
  referralsFrom   Referral[]             @relation("ReferralFrom")
  referralsTo     Referral[]             @relation("ReferralTo")
  doctorUser      DoctorUser?
  careRecords     CareRecordGeneration[]
}

// Authentication identity for a Doctor. One-to-one with Doctor.
// Created lazily on first magic-link request — Doctor profiles can exist
// without a DoctorUser (passive WhatsApp recipient). Once a doctor signs in,
// the DoctorUser row tracks magic-link tokens (hashed) and login history.
model DoctorUser {
  id                  String    @id @default(uuid())
  doctorId            String    @unique
  doctor              Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  email               String    @unique
  // Magic-link tokens are SHA-256 hashed before storage. Single-use, 15-min TTL.
  magicLinkTokenHash  String?
  magicLinkExpiresAt  DateTime?
  magicLinkUsedAt     DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([magicLinkTokenHash])
}

model Checkin {
  id             String   @id @default(uuid())
  patientId      String
  score          Int
  symptoms       String[]
  emotionalState String?
  notes          String?
  cycleDay       Int
  messageId      String?
  ctcaeGrades    Json?    // { "nausea": 2, "fatigue": 1 } — CTCAE Grade 1–5 per symptom
  ecogScore      Int?
  createdAt      DateTime @default(now())

  patient          Patient @relation(fields: [patientId], references: [id])
  alertsTriggered  Alert[]
}

model Medication {
  id           String   @id @default(uuid())
  patientId    String
  name         String
  genericName  String?
  purpose      String
  frequency    String
  timing       String
  sideEffects  String[]
  watchFor     String[]
  contextSent  Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  patient       Patient          @relation(fields: [patientId], references: [id])
  adherenceLogs MedicationLog[]
}

model MedicationLog {
  id           String    @id @default(uuid())
  medicationId String
  patientId    String
  taken        Boolean
  takenAt      DateTime?
  createdAt    DateTime  @default(now())

  medication Medication @relation(fields: [medicationId], references: [id])
}

model Appointment {
  id              String   @id @default(uuid())
  patientId       String
  doctorId        String?
  doctorName      String
  hospitalName    String
  type            String
  scheduledAt     DateTime
  status          String   @default("pending")
  practoBookingId String?
  apolloBookingId String?
  manualBooking   Boolean  @default(false)
  prepNotesSent   Boolean  @default(false)
  briefSent       Boolean  @default(false)
  postVisitSent   Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model Alert {
  id                   String    @id @default(uuid())
  patientId            String
  checkinId            String?
  type                 String
  severity             String
  message              String
  caregiverNotified    Boolean   @default(false)
  coordinatorNotified  Boolean   @default(false)
  doctorNotified       Boolean   @default(false)
  resolved             Boolean   @default(false)
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())

  patient    Patient         @relation(fields: [patientId], references: [id])
  checkin    Checkin?        @relation(fields: [checkinId], references: [id])
  deliveries AlertDelivery[]
}

model Conversation {
  id          String   @id @default(uuid())
  patientId   String
  role        String
  messageType String
  content     String
  isNightMode Boolean  @default(false)
  intent      String?
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model CaregiverConversation {
  id          String   @id @default(uuid())
  caregiverId String
  role        String
  content     String
  createdAt   DateTime @default(now())

  caregiver Caregiver @relation(fields: [caregiverId], references: [id])
}

model TreatmentProtocol {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  cancerTypes String[]
  totalCycles Int
  cycleDays   Int
  dayProfiles Json
  medications Json
  createdAt   DateTime @default(now())
}

model Coordinator {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("COORDINATOR") // COORDINATOR | ADMIN
  hospitalName String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  patients       Patient[]
  referralsMade  Referral[]
}

model CoordinatorTask {
  id          String    @id @default(uuid())
  patientId   String
  type        String
  description String
  context     Json?
  status      String    @default("open")
  priority    String    @default("normal")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

// ─── Patient Record Storehouse Models ───────────────────────────────────────

model LabResult {
  id          String    @id @default(uuid())
  patientId   String
  testDate    DateTime
  reportedAt  DateTime?
  category    String    // CBC, LFT, KFT, TUMOUR_MARKER, COAGULATION, URINE, OTHER
  testName    String
  value       Float?
  unit        String?
  refMin      Float?
  refMax      Float?
  isAbnormal  Boolean   @default(false)
  flag        String?   // HIGH, LOW, CRITICAL, NORMAL
  rawText     String?
  cycleNumber Int?
  cycleDay    Int?
  orderedBy   String?
  source      String    @default("manual") // manual | pdf_extract | hl7 | fhir
  documentId  String?
  notes       String?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model ImagingReport {
  id          String    @id @default(uuid())
  patientId   String
  studyDate   DateTime
  reportedAt  DateTime?
  modality    String    // CT, MRI, PET-CT, X-RAY, ULTRASOUND, BONE-SCAN, MAMMOGRAPHY
  bodyPart    String
  indication  String?
  findings    String?
  impression  String?
  response    String?   // RECIST: CR, PR, SD, PD
  radiologist String?
  referenceId String?
  documentId  String?
  source      String    @default("manual")
  notes       String?
  createdAt   DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model PathologyReport {
  id             String    @id @default(uuid())
  patientId      String
  reportDate     DateTime
  specimenType   String    // BIOPSY, SURGICAL, CYTOLOGY, BONE_MARROW, BLOOD
  site           String
  diagnosis      String
  grade          String?
  stage          String?   // pathological stage e.g., pT2N1M0
  margins        String?   // clear | involved | close
  ihcFindings    Json?     // { "ER": "positive 80%", "HER2": "negative", "Ki67": "25%" }
  molecularTests Json?     // { "BRCA1": "wildtype", "KRAS": "mutant codon 12" }
  pathologist    String?
  labName        String?
  referenceId    String?
  documentId     String?
  source         String    @default("manual")
  notes          String?
  createdAt      DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model VitalSign {
  id          String    @id @default(uuid())
  patientId   String
  recordedAt  DateTime
  weight      Float?    // kg
  height      Float?    // cm
  bmi         Float?
  temperature Float?    // °C
  bpSystolic  Int?
  bpDiastolic Int?
  pulseRate   Int?
  oxygenSat   Float?    // SpO2 %
  ecogScore   Int?      // 0–4
  painScore   Int?      // 0–10
  source      String    @default("manual") // manual | bot
  cycleNumber Int?
  cycleDay    Int?
  createdAt   DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model ClinicalNote {
  id          String    @id @default(uuid())
  patientId   String
  noteDate    DateTime
  noteType    String    // CONSULTATION, PROGRESS, DISCHARGE, MDT_DECISION, PROCEDURE, NURSING
  title       String
  content     String
  authorName  String
  authorRole  String    // ONCOLOGIST, COORDINATOR, NURSE, SOCIAL_WORKER, etc.
  isPrivate   Boolean   @default(false)
  cycleNumber Int?
  tags        String[]
  documentId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
}

model PatientDocument {
  id            String    @id @default(uuid())
  patientId     String
  documentDate  DateTime?
  category      String    // LAB_REPORT, IMAGING, PATHOLOGY, PRESCRIPTION, DISCHARGE_SUMMARY, CONSENT, INSURANCE, OTHER
  title         String
  description   String?
  storagePath   String    // Supabase storage path — never exposed as a public URL
  fileType      String    // pdf | jpg | png | docx
  fileSizeBytes Int?
  uploadedBy    String?
  isVerified    Boolean   @default(false)
  extractedData Json?     // AI-extracted structured content
  tags          String[]
  createdAt     DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model CareTeamMember {
  id           String    @id @default(uuid())
  patientId    String
  role         String    // MEDICAL_ONCOLOGIST, RADIATION_ONCOLOGIST, SURGICAL_ONCOLOGIST,
                         // PALLIATIVE, NURSE, DIETITIAN, PSYCHO_ONCOLOGIST, PHARMACIST, SOCIAL_WORKER
  name         String
  phone        String?
  email        String?
  hospitalName String?
  department   String?
  isPrimary    Boolean   @default(false)
  isActive     Boolean   @default(true)
  doctorId     String?   // optional link to Doctor profile
  createdAt    DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor? @relation(fields: [doctorId], references: [id])
}

model ExtractedRecordDraft {
  id            String    @id @default(uuid())
  patientId     String
  documentId    String
  category      String    // LAB_REPORT, IMAGING, PATHOLOGY
  extractedData Json      // AI-extracted structured content awaiting review
  status        String    @default("pending") // pending | approved | rejected
  rejectionReason String?
  reviewedAt    DateTime?
  reviewedBy    String?   // Coordinator ID who approved/rejected
  createdAt     DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

// ─── Tumor Board / MDT Models ────────────────────────────────────────────────

model TumorBoardMeeting {
  id               String   @id @default(uuid())
  patientId        String
  title            String
  scheduledAt      DateTime
  status           String   @default("scheduled") // scheduled | in-progress | completed | cancelled
  mode             String   @default("sync")       // sync | async
  agenda           String?
  briefText        String?  // AI MDT brief snapshot at meeting time
  decision         Json?    // { treatment, protocol, nextReview, notes, linkedTrialIds }
  consensusReached Boolean  @default(false)
  meetingNotes     String?
  createdBy        String   // Coordinator.id
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient      Patient                 @relation(fields: [patientId], references: [id])
  participants TumorBoardParticipant[]
}

model TumorBoardParticipant {
  id               String    @id @default(uuid())
  meetingId        String
  name             String
  role             String    // care team role label
  email            String?
  phone            String?
  attendanceStatus String    @default("invited") // invited | attended | declined
  comments         String?
  signedOff        Boolean   @default(false)
  signedOffAt      DateTime?
  createdAt        DateTime  @default(now())

  meeting TumorBoardMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model AlertDelivery {
  id           String    @id @default(uuid())
  alertId      String
  channel      String    // whatsapp | telegram | email | in-app
  recipientRef String    // phone number or email
  status       String    @default("pending") // pending | sent | failed | delivered
  sentAt       DateTime?
  retryCount   Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())

  alert Alert @relation(fields: [alertId], references: [id])
}

// ─── Outbound Message Log ────────────────────────────────────────────────────

model OutboundMessage {
  id            String   @id @default(uuid())
  patientId     String
  channel       String   // whatsapp | telegram
  recipientRef  String   // phone or chatId
  messageType   String   // checkin_prompt | appointment_reminder | appointment_brief |
                         // medication_reminder | caregiver_brief | doctor_signal |
                         // coordinator_manual | alert_followup | referral_notification
  content       String
  externalId    String?  // message ID returned by WhatsApp/Telegram API
  status        String   @default("sent") // sent | failed
  jobId         String?  // BullMQ job ID for traceability
  sentAt        DateTime @default(now())
  failureReason String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, sentAt])
  @@index([sentAt])
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id              String   @id @default(uuid())
  coordinatorId   String
  patientId       String
  action          String   // patient_view | patient_list | record_view | document_download
  resourceType    String?  // lab_result | imaging | document | checkin | conversation
  resourceId      String?
  isOutOfScope    Boolean  @default(false)  // coordinator != assignedCoordinatorId
  isCrossHospital Boolean  @default(false)
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([coordinatorId, createdAt])
  @@index([patientId, createdAt])
  @@index([isOutOfScope, createdAt])
}

// ─── Referral ────────────────────────────────────────────────────────────────

model Referral {
  id                String    @id @default(uuid())
  patientId         String
  fromDoctorId      String?
  fromCoordinatorId String?
  toDoctorId        String
  reason            String
  urgency           String    @default("routine") // routine | urgent | emergency
  clinicalContext   String?
  status            String    @default("pending")
                              // pending | accepted | seen | completed | declined
  acceptedAt        DateTime?
  seenAt            DateTime?
  completedAt       DateTime?
  declinedAt        DateTime?
  declineReason     String?
  notificationSent  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  patient         Patient      @relation(fields: [patientId], references: [id])
  fromDoctor      Doctor?      @relation("ReferralFrom", fields: [fromDoctorId], references: [id])
  fromCoordinator Coordinator? @relation(fields: [fromCoordinatorId], references: [id])
  toDoctor        Doctor       @relation("ReferralTo", fields: [toDoctorId], references: [id])

  @@index([patientId])
  @@index([toDoctorId, status])
  @@index([status, createdAt])
}

// ─── Hook 3: Defense Mode ───────────────────────────────────────────────────

model CareRecordGeneration {
  id           String   @id @default(uuid())
  patientId    String
  doctorId     String   // Doctor.id (not DoctorUser)
  jsonHash     String   // SHA-256 of the aggregated JSON payload (tamper-evident)
  storageKey   String?  // Supabase Storage object key for the archived JSON
  emailSentTo  String?  // doctor's verified email
  rowCount     Json     // { appointments, labs, checkins, ... } for audit
  generatedAt  DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@index([patientId, generatedAt])
  @@index([doctorId])
}
