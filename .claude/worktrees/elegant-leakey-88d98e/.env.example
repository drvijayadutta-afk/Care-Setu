# Server
PORT=3000
NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/cancer_ai"

# Redis (Railway or Upstash)
REDIS_URL="redis://localhost:6379"

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_permanent_access_token"
WHATSAPP_VERIFY_TOKEN="your_webhook_verify_token"
WHATSAPP_API_VERSION="v21.0"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI (Whisper for voice transcription)
OPENAI_API_KEY="sk-..."

# Practo Partner API
PRACTO_CLIENT_ID="your_practo_client_id"
PRACTO_CLIENT_SECRET="your_practo_client_secret"
PRACTO_API_BASE="https://api.practo.com/v1"

# Apollo Hospitals API
APOLLO_API_KEY="your_apollo_api_key"
APOLLO_API_BASE="https://api.apollohospitals.com/v1"

# Care Coordinator (receives urgent alerts)
COORDINATOR_WHATSAPP_NUMBER="91XXXXXXXXXX"
